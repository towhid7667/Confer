<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.towhid7667.confer</id>
    <name>Confer</name>
    <vendor>towhid7667</vendor>
    <description><![CDATA[
        <p><b>Confer</b> is a repository that provides a pure template to make it easier to create a new plugin project.</p>
        <p>The main goal of this template is to speed up the setup phase of plugin development for both new and experienced developers by preconfiguring the project scaffold and CI, linking to the proper documentation pages, and keeping everything organized.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action
            id="Confer.InjectContext"
            class="com.github.towhid7667.confer.actions.InjectContextAction"
            text="Inject into Confer Chat"
            description="Injects the current selection (or file path) into the Confer chat input as a @file#L reference"
        >
            <keyboard-shortcut keymap="$default" first-keystroke="shift alt C"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
            id="Confer.OpenChat"
            class="com.github.towhid7667.confer.actions.OpenConferAction"
            text="Open Confer Chat"
            description="Opens the Confer chat panel"
            icon="/icons/confer.svg"
        >
            <!-- Best-effort placement: the floating icon group in the top-right of the editor.
                 Unverified against this exact platform version — check visually via runIde. -->
            <add-to-group group-id="EditorContextBarMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="com.github.towhid7667.confer.toolWindow.ConferToolWindowFactory"
            id="Confer"
            anchor="right"
            secondary="false"
            canCloseContents="false"
            icon="/icons/confer.svg"
        />
        <applicationService
            serviceImplementation="com.github.towhid7667.confer.settings.ClaudeSettings"
        />
        <applicationConfigurable
            id="com.github.towhid7667.confer.settings.ClaudeConfigurable"
            instance="com.github.towhid7667.confer.settings.ClaudeConfigurable"
            displayName="Confer"
        />
        <fileEditorProvider implementation="com.github.towhid7667.confer.toolWindow.ConferFileEditorProvider"/>
        <statusBarWidgetFactory id="ConferStatusBarWidget" implementation="com.github.towhid7667.confer.statusbar.ConferStatusBarWidgetFactory"/>
        <notificationGroup id="Confer" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
